# Application
APP_NAME=Gtrack
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

# =============================================================
# Database (Supabase Postgres)
# =============================================================
# Supabase gives you 3 connection strings. For this FastAPI app
# use the **Session Pooler** one (port 5432, host *.pooler.supabase.com).
#
# Steps:
#   1. Supabase Dashboard -> Connect -> "Session pooler"
#   2. Copy the URI, e.g.
#      postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
#   3. Prefix the scheme with `+psycopg2` and append `?sslmode=require`
#   4. URL-encode any special chars in the password (@ -> %40, etc.)
#
# Example:
# DATABASE_URL=postgresql+psycopg2://postgres.vzggfomfrabfpzjlpnvy:MyP%40ss@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Optional async URL (only needed if you also want to use asyncpg).
# Most of this codebase uses the sync engine above; leave this blank if unused.
# ASYNC_DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-YOUR_REGION.pooler.supabase.com:5432/postgres


# =============================================================
# Supabase (OPTIONAL — only needed if you want to integrate with
# Supabase Auth / Storage / Admin APIs from this backend).
#
# If you only use Supabase as the Postgres database (via DATABASE_URL
# above) you can leave EVERY variable in this section blank.
#
# Where to find these:
#   Supabase Dashboard -> Project Settings -> API
# =============================================================

# Your project URL. Format: https://<project-ref>.supabase.co
# Dashboard -> Project Settings -> API -> "Project URL"
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# PUBLIC key — safe in browsers. Subject to Row Level Security.
# The backend almost never needs this; it's listed for completeness.
# Dashboard -> Project Settings -> API -> "Project API keys" -> anon public
SUPABASE_ANON_KEY=

# SECRET key — BYPASSES Row Level Security. Server-only, never ship to clients.
# Needed only if this backend should:
#   - create users in Supabase Auth (sign-up, magic links, password reset)
#   - read/write Supabase Storage with admin powers
# Dashboard -> Project Settings -> API -> "Project API keys" -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# HS256 signing secret for Supabase-issued user JWTs.
# Needed only if your FRONTEND authenticates via Supabase Auth and forwards
# the Supabase JWT to this FastAPI backend, and you want to verify it with
# app.core.supabase_client.verify_supabase_jwt().
# Dashboard -> Project Settings -> API -> "JWT Settings" -> "JWT Secret"
SUPABASE_JWT_SECRET=


# JWT
JWT_SECRET_KEY=change-me-to-a-very-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=gtrack
JWT_AUDIENCE=gtrack-api

# Invites
INVITE_EXPIRE_HOURS=72
INVITE_BASE_URL=http://localhost:3000/accept-invite

# Rate limiting
RATE_LIMIT_PER_MINUTE=100

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
